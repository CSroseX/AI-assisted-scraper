# The official Playwright image ships Chromium and every system library it
# needs. Its tag must match the playwright version in package-lock.json, and
# the digest pins it so a rebuild can't change the image underneath us.
FROM mcr.microsoft.com/playwright:v1.64.0-noble@sha256:06a9939e57531807f8d5fd76ce44b53165ffb7d7501d87ab10e285c20b1e971f

# The data volume takes /data's owner when Docker first creates it, so the
# non-root user can write the database and evidence there.
RUN mkdir -p /app /data && chown pwuser:pwuser /app /data
WORKDIR /app
USER pwuser

# Copy package.json and package-lock.json first (for caching)
COPY --chown=pwuser:pwuser package*.json ./

# Install runtime dependencies with lockfile fidelity. better-sqlite3 is the
# only dependency with an install step, a node-gyp build this image has no
# compiler for; it loads its bundled prebuilt binary instead.
RUN npm ci --omit=dev --ignore-scripts

# Copy the rest of your backend code
COPY --chown=pwuser:pwuser . .

EXPOSE 5000
# Running node as PID 1 lets SIGTERM reach the app's graceful shutdown.
ENTRYPOINT ["node", "index.js"]
