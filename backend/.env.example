# Required
GROQ_API_KEY=your_groq_api_key
CLEAR_API_TOKEN=change_me_to_a_long_random_string

# Service wiring (docker-compose overrides VERSION_API_BASE to http://chromadb:8001)
VERSION_API_BASE=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional
GROQ_MODEL=openai/gpt-oss-20b
HTTP_TIMEOUT_MS=20000
PORT=5000

# Abuse protection (defaults shown)
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
SCRAPE_RATE_LIMIT_MAX=10
MAX_CONCURRENT_SCRAPES=3
SCREENSHOT_TTL_MS=3600000
