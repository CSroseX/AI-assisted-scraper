# Required
GROQ_API_KEY=your_groq_api_key

# Service wiring
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional
GROQ_MODEL=openai/gpt-oss-20b
HTTP_TIMEOUT_MS=20000
PORT=5000
# docker-compose overrides this to /data/watchdog.db
DB_PATH=./data/watchdog.db

# Scheduler (defaults shown). Set SCHEDULER_ENABLED=false to run the API
# without recurring checks.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_MS=60000
SCHEDULER_BATCH_SIZE=5
SCHEDULER_JITTER_RATIO=0.1
SCHEDULER_MAX_FAILURES=5
SCHEDULER_BACKOFF_BASE_MS=300000
SCHEDULER_BACKOFF_MAX_MS=21600000

# Explainer (defaults shown). Set EXPLAIN_ENABLED=false to detect changes
# without calling the LLM, e.g. when running without a GROQ_API_KEY.
EXPLAIN_ENABLED=true
# Diffs larger than this are treated as a redesign and never sent to the model,
# which caps cost in the worst case.
EXPLAIN_MAX_PARAGRAPHS=40
EXPLAIN_MAX_CHARS=8000

# Alerts (default shown: 7 days). The same change repeating on the same watch
# within this window is stored as 'suppressed' instead of alerting again.
ALERT_REPEAT_WINDOW_MS=604800000

# RSS feeds and evidence pages stay off until this is set. It is the secret
# part of every link they use (?token=...), so anyone with a link can open it.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Feeds: /feed.xml (all watches) and /watches/<id>/feed.xml (one watch).
LINK_TOKEN=
# The address people reach this backend at, used to build links in feeds and
# emails. Defaults to http://localhost:<PORT>.
# PUBLIC_BASE_URL=https://watchdog.example.com

# Email alerts. Until these are set, email alerts wait as 'pending' and each
# records which setting is missing; they go out once email is configured.
#
# Testing, no signup: a throwaway Ethereal inbox. Each send logs a link to view
# the message. Those pages are PUBLIC and the email contains your evidence link,
# so use a throwaway LINK_TOKEN while testing this way.
# EMAIL_TRANSPORT=ethereal
#
# Real email: any SMTP server (Gmail with an app password, Amazon SES, Resend,
# Brevo...). Port 465 uses TLS from the start; 587 upgrades with STARTTLS.
EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
# All email alerts go to this one address until accounts exist.
ALERT_EMAIL_TO=
# Sender pass interval and how many tries before an alert is marked failed.
EMAIL_TICK_MS=30000
EMAIL_MAX_ATTEMPTS=5

# Abuse protection (defaults shown)
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
SCRAPE_RATE_LIMIT_MAX=10
MAX_CONCURRENT_SCRAPES=3
SCREENSHOT_TTL_MS=3600000
# Screenshots that back a watch snapshot are kept here, outside the TTL above.
# Defaults to an "evidence" folder next to DB_PATH (on the Docker volume).
# EVIDENCE_DIR=./data/evidence
